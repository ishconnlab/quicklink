# Copy to server/.env and adjust the values. NEVER commit the real .env file.
#
# ------------------- Local development -------------------
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/quicklink
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
CORS_ORIGIN=https://quicklink-zeta.vercel.app
OWNER_NAME=QuickLink Owner
OWNER_EMAIL=owner@quicklink.local
OWNER_PASSWORD=ChangeMe123!
TRUST_PROXY=false
LEARNING_SUPPORTED_FORMATS=pdf,doc,docx,txt,md,ppt,pptx,xls,xlsx
LEARNING_MAX_FILE_BYTES=26214400
# Optional writable persistent directory for administrator uploads. Defaults to server/src/books.
# LEARNING_BOOKS_DIR=/var/data/quicklink/books
# Optional persistent storage locations for book covers, course thumbnails, and practical submissions.
# BOOK_COVER_DIR=/var/data/quicklink/book-covers
# COURSE_IMAGE_DIR=/var/data/quicklink/course-images
# SUBMISSIONS_DIR=/var/data/quicklink/submissions

# ---------------- Live classroom media (LiveKit) ----------------
# Create these in your LiveKit project. Keep the API secret server-side.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ---------------- Email invitations ----------------
# SMTP_URL is a Nodemailer SMTP connection URL. All invitations are sent as
# individual messages and only to existing students enrolled in the class.
SMTP_URL=
MAIL_FROM=QuickLink <classes@example.com>
APP_URL=http://localhost:5173

# ---------------- Production (Render dashboard) ----------------
# Set these in the Render service's "Environment" tab, not in this file.
# PORT is provided automatically by Render — do NOT set it manually.
#
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/quicklink?retryWrites=true&w=majority
# JWT_SECRET=<long random string, e.g. `openssl rand -hex 32`>
# JWT_EXPIRES_IN=12h
# CORS_ORIGIN=https://quicklink-zeta.vercel.app
# OWNER_NAME=QuickLink Owner
# OWNER_EMAIL=<owner email address>
# OWNER_PASSWORD=<strong owner password>
# TRUST_PROXY=true
