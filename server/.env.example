# QuickLink backend environment template.
# Add these values to server/.env for local development.
# In production, set identical values in the Render dashboard.

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/quicklink
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=12h
CORS_ORIGIN=https://quicklink-zeta.vercel.app
OWNER_NAME=QuickLink Owner
OWNER_EMAIL=owner@quicklink.local
OWNER_PASSWORD=ChangeMe123!
TRUST_PROXY=false
# Required for Cloudinary-backed class and registration images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=quicklink
# Create a LiveKit Cloud project, then set all three LiveKit values in the
# backend environment (for example, the Render service's Environment tab).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SMTP_URL=
MAIL_FROM=
APP_URL=
PUBLIC_API_URL=
LEARNING_SUPPORTED_FORMATS=pdf,doc,docx,txt,md,ppt,pptx,xls,xlsx
LEARNING_MAX_FILE_BYTES=26214400
LEARNING_BOOKS_DIR=
BOOK_COVER_DIR=
COURSE_IMAGE_DIR=
SUBMISSIONS_DIR=
REGISTRATION_IMAGE_DIR=
