# Copy to client/.env for local development.
# Leave VITE_API_URL empty in development to use the Vite dev proxy (/api -> quicklink-3eng.onrender.com).
VITE_API_URL=

# Production: set this as a Vercel Environment Variable so the SPA calls the
# deployed backend. If it is omitted, src/api/client.js falls back to the known
# Render URL in production builds.
# VITE_API_URL=https://quicklink-3eng.onrender.com
