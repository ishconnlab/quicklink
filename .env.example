# QuickLink environment reference.
# Copy the relevant sections into server/.env and client/.env for local
# development. In production these are configured in the Render and Vercel
# dashboards. Never commit real secrets.

# ---- Backend (server/.env) ----
# NODE_ENV=development
# PORT=4000
# MONGODB_URI=mongodb://127.0.0.1:27017/quicklink
# JWT_SECRET=change-me-to-a-long-random-secret-string
# JWT_EXPIRES_IN=12h
# CORS_ORIGIN=https://quicklink-zeta.vercel.app
# OWNER_NAME=QuickLink Owner
# OWNER_EMAIL=owner@quicklink.local
# OWNER_PASSWORD=ChangeMe123!
# TRUST_PROXY=false

# ---- Backend (Render → Environment tab) ----
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/quicklink?retryWrites=true&w=majority
# JWT_SECRET=<long random string>
# JWT_EXPIRES_IN=12h
# CORS_ORIGIN=https://quicklink-zeta.vercel.app
# OWNER_NAME=QuickLink Owner
# OWNER_EMAIL=<owner email>
# OWNER_PASSWORD=<strong owner password>
# TRUST_PROXY=true
# (PORT is provided automatically by Render.)

# ---- Optional backend integrations (server/.env) ----
# Live classes require a LiveKit Cloud project. Copy its URL, API key, and
# secret from the provider dashboard. Never put the secret in client/.env or
# in a VITE_* variable.
# LIVEKIT_URL=wss://<your-livekit-project>.livekit.cloud
# LIVEKIT_API_KEY=<LiveKit API key>
# LIVEKIT_API_SECRET=<LiveKit API secret>
#
# Email invitations require an SMTP account. Example URL format:
# SMTP_URL=smtps://<username>:<url-encoded-password>@<smtp-host>:465
# MAIL_FROM=QuickLink Classes <classes@your-domain.example>
# APP_URL=http://localhost:5173
#
# Optional storage locations. Defaults are directories under server/.
# LEARNING_SUPPORTED_FORMATS=pdf,doc,docx,txt,md,ppt,pptx,xls,xlsx
# LEARNING_MAX_FILE_BYTES=26214400
# LEARNING_BOOKS_DIR=
# BOOK_COVER_DIR=
# COURSE_IMAGE_DIR=
# SUBMISSIONS_DIR=

# ---- Frontend (client/.env or Vercel env) ----
# Leave empty in development to use the Vite dev proxy.
# VITE_API_URL=
# In production:
# VITE_API_URL=https://quicklink-3eng.onrender.com
