# ---- Backend (server/.env) ----
# Copy this file to server/.env and adjust the values.
NODE_ENV=development
PORT=4000

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/quicklink

# JWT secret - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=12h

# Comma separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# First owner account created automatically on first boot
OWNER_NAME=QuickLink Owner
OWNER_EMAIL=owner@quicklink.local
OWNER_PASSWORD=ChangeMe123!

# ---- Frontend (client/.env) ----
# Base URL of the backend API. Leave empty to use the Vite dev proxy in development.
VITE_API_URL=
