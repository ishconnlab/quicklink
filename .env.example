# QuickLink environment reference.
# Copy the relevant sections into server/.env and client/.env for local
# development. In production these are configured in the Render and Vercel
# dashboards. Never commit real secrets.

# ---- Backend (server/.env) ----
# NODE_ENV=development
# PORT=4000
# MONGODB_URI=mongodb://127.0.0.1:27017/quicklink
# JWT_SECRET=change-me-to-a-long-random-secret-string
# JWT_EXPIRES_IN=12h
# CORS_ORIGIN=https://quicklink-zeta.vercel.app
# OWNER_NAME=QuickLink Owner
# OWNER_EMAIL=owner@quicklink.local
# OWNER_PASSWORD=ChangeMe123!
# TRUST_PROXY=false
# Required for Cloudinary-backed class and registration images. In Render,
# copy these from the Cloudinary dashboard; never use frontend variables.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_FOLDER_PREFIX=quicklink
# REGISTRATION_IMAGE_DIR=
# SMTP_URL=smtp://your-smtp-username:your-smtp-password@smtp.your-provider.com:587
# MAIL_FROM="QuickLink Learning Portal <verified-sender@your-domain.com>"
# APP_URL=https://quicklink-zeta.vercel.app
# PUBLIC_API_URL=https://quicklink-3eng.onrender.com

# ---- Frontend (client/.env or Vercel env) ----
# Leave empty in development to use the Vite dev proxy.
# VITE_API_URL=
# In production:
# VITE_API_URL=https://quicklink-3eng.onrender.com
